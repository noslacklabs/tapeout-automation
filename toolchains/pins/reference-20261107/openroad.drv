sTargetTarget\":[],\"depsTargetTargetPropagated\":[],\"doCheck\":true,\"doInstallCheck\":true,\"env\":{\"NIX_MAIN_PROGRAM\":\"openroad\"},\"mesonFlags\":[],\"name\":\"openroad-26Q3\",\"nativeBuildInputs\":[\"/nix/store/nilcmqdvnpv02v3n63rwnr7pl1zhbgm7-bison-3.8.2\",\"/nix/store/rlpcs1h48m058z811xxkn5672v77p5qj-cmake-4.4.4\",\"/nix/store/4dx6wab65vn5362ydc64wshqc2zq1m7f-doxygen-1.17.0\",\"/nix/store/m302wmq507k12h99k3x3l9ylnnr92y7h-flex-2.6.4\",\"/nix/store/2wlays4ahsvdx02v84s3x91ri2623qbl-git-minimal-2.56.0\",\"/nix/store/fvnmv829ac6ld0157rdiznyd467r1dy0-wrap-qt5-apps-hook\",\"/nix/store/s70gz6bvz74c36xigh5m2ab2cqli08cv-pkg-config-wrapper-0.29.2\",\"/nix/store/xahxrjs30p3mw0a42bqg9ikgkikskw8m-python3-3.14.8\",\"/nix/store/0phhnzcrsjrn12pwp7dykjpqki9mplv0-swig-4.4.1\",\"/nix/store/vj95j5874ahl4ba6ydkmwhgj9wpa26x6-tcl-8.6.16\",\"/nix/store/amc08awcxvz178lqqc0y5n568ch1bzxg-version-check-hook\"],\"outputChecks\":{\"out\":{}},\"outputs\":[\"out\"],\"patches\":[\"/nix/store/01bzq8c2aj0pql25f0vs1i9a0qln13aa-0e40b4f8a1c4b6af7225da31cd88a1d29d8a04a2.patch\"],\"pname\":\"openroad\",\"postPatch\":\"patchShebangs etc/\\n# New in 26Q3: src/web's CMakeLists.txt invokes these scripts directly\\n# as build steps (not just at runtime) to embed web/report assets.\\npatchShebangs src/web/src/\\n\\n# Disable CutGTests because it misses core manager implementation\\n# and fails under strict Nix linking. Filed as issue #9563.\\nif [ -f src/cut/test/cpp/CMakeLists.txt ]; then\\n  echo \\\"\\\" > src/cut/test/cpp/CMakeLists.txt\\nfi\\n\\n# OpenROAD vendors its own slang copy (third-party/slang-elab), separate\\n# from nixpkgs' sv-lang_10 -- same fmt 12 fmt::format/fmt/core.h vs.\\n# fmt/format.h split as sv-lang_10 (see its own package.nix comment for\\n# the full explanation), same fix.\\nif [ -d third-party/slang-elab/third_party/slang ]; then\\n  grep -rl '#include <fmt/core.h>' \\\\\\n    --include='*.h' --include='*.cpp' \\\\\\n    third-party/slang-elab/third_party/slang | \\\\\\n    xargs sed -i 's|#include <fmt/core.h>|#include <fmt/format.h>|'\\nfi\\n\",\"propagatedBuildInputs\":[],\"propagatedNativeBuildInputs\":[],\"qtWrapperArgs\":[\"--prefix\",\"PATH\",\":\",\"/nix/store/cfry5mn7l5qk6cy730gspaa51fahc108-yosys-0.70/bin\"],\"src\":\"/nix/store/vdlfwb1wfg6awdn291vgkjiz68qsfahi-source\",\"stdenv\":\"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux\",\"strictDeps\":true,\"system\":\"x86_64-linux\",\"version\":\"26Q3\",\"versionCheckProgramArg\":\"-version\"}"),("out","/nix/store/6qbn5zjnnnyna6md4rsmiqw4y26y8556-openroad-26Q3")])